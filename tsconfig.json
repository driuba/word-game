{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"compilerOptions": {
		"allowArbitraryExtensions": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"module": "node20",
		"moduleResolution": "node16",
		"outDir": "./dist",
		"paths": {
			"~/*": [
				"./src/*"
			]
		},
		"resolveJsonModule": true,
		"rootDir": "./src",
		"sourceMap": true,
		"strict": true,
		"target": "es2025",
		"types": ["node"],
		"verbatimModuleSyntax": true
	},
	"display": "word-game",
	"exclude": [
		"./src/migrations/**/*"
	],
	"include": [
		"./src/**/*"
	],
	"ts-node": {
		"esm": true,
		"files": true,
		"scope": true
	}
}
